<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Debug-only: allow cleartext HTTP so the app can talk to a local mock
         API server (e.g. http://10.0.2.2) during development. Release builds are
         unaffected and remain HTTPS-only. -->
    <application android:usesCleartextTraffic="true" />
</manifest>
